@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Set up authenticator app";
}

<div class="container form-page" style="padding-top:1.5rem;">
    <div class="d-flex align-items-center gap-2 mb-3">
        <a asp-page="./TwoFactorAuthentication" class="btn btn-sm btn-outline-secondary">
            <svg class="hgi hgi-sm"><use href="#i-arrow-left"></use></svg>
        </a>
        <h2 class="mb-0">Set up authenticator app</h2>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="uc-form-card mb-3">
        <ol class="mb-0" style="padding-left:1.1rem;">
            <li class="mb-3">
                <strong>Install an authenticator app</strong>
                <p class="text-muted small mb-0">
                    Google Authenticator, Microsoft Authenticator, or Authy — all free,
                    and all work offline. Any one of them is fine.
                </p>
            </li>

            <li class="mb-3">
                <strong>Scan this with the app</strong>

                @* The QR is rendered client-side into #qrCode from the URI in
                   #qrCodeData. If the library does not load, the script reveals
                   the manual key block instead of leaving an empty square —
                   which is why the manual path shipped first and still works on
                   its own. *@
                <div id="qrBlock" class="my-2">
                    <div id="qrCode"
                         style="display:inline-block;padding:12px;background:#fff;
                                border:1px solid var(--uc-border,#e2e8f0);border-radius:12px;"></div>
                    <p class="text-muted small mt-2 mb-0">
                        Open your authenticator app, choose <em>scan a QR code</em>, and point it here.
                    </p>
                </div>
                <div id="qrCodeData" data-url="@Model.AuthenticatorUri" hidden></div>

                <details id="manualKey" class="mt-2">
                    <summary class="small" style="cursor:pointer;">Can't scan? Enter the key by hand</summary>

                    <p class="text-muted small mb-2 mt-2">
                        Choose <em>enter a setup key</em> in the app, then type this key:
                    </p>

                    <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                        <code id="sharedKey"
                              style="font-size:1.05rem;letter-spacing:.06em;background:#f1f5f9;
                                     padding:.5rem .75rem;border-radius:8px;user-select:all;">@Model.SharedKey</code>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                data-copy-target="sharedKey">
                            <svg class="hgi hgi-sm me-1"><use href="#i-copy"></use></svg>Copy
                        </button>
                    </div>

                    <p class="text-muted small mb-0">
                        Spaces are for readability — the app accepts it with or without them.
                        Set the account type to <strong>time-based</strong> if asked.
                    </p>
                </details>
            </li>

            <li>
                <strong>Enter the code the app shows</strong>
                <p class="text-muted small mb-2">
                    The code changes every 30 seconds. If it is rejected, wait for the
                    next one rather than retyping the same digits.
                </p>

                <form method="post" class="row g-2 align-items-start" style="max-width:26rem;">
                    @Html.AntiForgeryToken()
                    <div class="col-auto">
                        <input asp-for="Input.Code" class="form-control"
                               autocomplete="off" inputmode="numeric" pattern="[0-9]*"
                               maxlength="7" placeholder="000000"
                               style="letter-spacing:.25em;font-size:1.05rem;width:9rem;" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">Verify and turn on</button>
                    </div>
                    <div class="col-12">
                        <span asp-validation-for="Input.Code" class="text-danger small"></span>
                    </div>
                </form>
            </li>
        </ol>
    </div>

    <div class="alert alert-info small">
        After verifying, you will be shown <strong>10 recovery codes</strong>. Save them —
        they are the only way back in if you lose your phone.
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @* Served locally, not from a CDN. Two reasons, and the second is the one
       that matters: a CDN outage would break enrolment during a demo, and this
       script handles the page that carries the shared secret — a compromised
       third-party file could read it straight out of the DOM. *@
    <script src="~/lib/qrcode/qrcode.js" asp-append-version="true"></script>

    <script>
        (function () {
            var holder = document.getElementById('qrCode');
            var data = document.getElementById('qrCodeData');
            var block = document.getElementById('qrBlock');
            var manual = document.getElementById('manualKey');
            if (!holder || !data) return;

            // Degrade to the manual key rather than showing an empty box.
            function fallBackToManualKey(reason) {
                if (block) block.style.display = 'none';
                if (manual) manual.open = true;
                console.error('QR unavailable, falling back to the manual key:', reason);
            }

            if (typeof QRCode === 'undefined') {
                fallBackToManualKey('qrcode.js did not load');
                return;
            }

            var canvas = document.createElement('canvas');
            holder.appendChild(canvas);

            QRCode.toCanvas(canvas, data.dataset.url, { width: 200, margin: 1 }, function (err) {
                if (err) fallBackToManualKey(err);
            });
        })();
    </script>

    <script>
        // Copy-to-clipboard for the manual key. Progressive: if the Clipboard
        // API is unavailable the key is still selectable by hand (user-select:all).
        document.querySelectorAll('[data-copy-target]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var el = document.getElementById(btn.dataset.copyTarget);
                if (!el || !navigator.clipboard) return;
                navigator.clipboard.writeText(el.textContent.trim()).then(function () {
                    var original = btn.innerHTML;
                    btn.innerHTML = 'Copied';
                    setTimeout(function () { btn.innerHTML = original; }, 1500);
                });
            });
        });
    </script>
}
