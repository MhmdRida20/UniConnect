@model IEnumerable<UniConnect.Models.Notification>
@{
    ViewData["Title"] = "Notifications";

    // Three distinct shells, deliberately:
    //   Admin/UniversityAdmin — a bare, standalone page (no sidebar at all).
    //     A notification usually points somewhere OUTSIDE the admin's own
    //     area entirely, so the full sidebar of admin tools was just noise
    //     here, not useful context. UniversityAdmin was previously missing
    //     from this check entirely and fell through to the STUDENT layout
    //     by mistake — fixed here too.
    //   DepartmentStaff/Company — the full portal layout, since their own
    //     sidebar IS directly relevant to what a notification tells them
    //     (e.g. a ticket response, a new applicant).
    //   Everyone else (students) — the normal student top-nav layout.
    var isAdminUser = User.IsInRole("Admin") || User.IsInRole("UniversityAdmin");
    var isPortalStaffUser = User.IsInRole("DepartmentStaff") || User.IsInRole("Company");
    Layout = isAdminUser ? "~/Views/Shared/_MinimalLayout.cshtml"
        : isPortalStaffUser ? "~/Views/Shared/_PortalLayout.cshtml"
        : "_Layout";

    // Both non-student shells (the bare admin page and the portal sidebar)
    // use the simpler, compact header below instead of the big decorative
    // hero — the hero fits the student page's more spacious feel, but reads
    // as excessive on either of the more focused/utilitarian admin views.
    var isNonStudentUser = isAdminUser || isPortalStaffUser;

    var notifications = Model.ToList();
    var newIds = ViewBag.NewIds as HashSet<int> ?? new HashSet<int>();
    var newCount = notifications.Count(n => newIds.Contains(n.Id));

    // Notification has no type column, so the service it belongs to is derived
    // from its Link — good enough to give each row a meaningful icon/accent
    // without a schema change.
    // Returns [icon-symbol-id, tone-suffix].
    string[] Kind(string? link)
    {
        var l = (link ?? string.Empty).ToLowerInvariant();
        if (l.Contains("/rides")) return new[] { "i-car", "teal" };
        if (l.Contains("/studygroups")) return new[] { "i-users", "green" };
        if (l.Contains("/tickets")) return new[] { "i-ticket", "red" };
        if (l.Contains("/clubs")) return new[] { "i-flag", "purple" };
        if (l.Contains("/internships") || l.Contains("/company")) return new[] { "i-briefcase", "amber" };
        if (l.Contains("attendance")) return new[] { "i-qr", "blue" };
        return new[] { "i-bell", "grey" };
    }

    string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return utc.ToLocalTime().ToString("MMM dd");
    }

    string Bucket(DateTime utc)
    {
        var local = utc.ToLocalTime().Date;
        var today = DateTime.Now.Date;
        if (local == today) return "Today";
        if (local == today.AddDays(-1)) return "Yesterday";
        if (local > today.AddDays(-7)) return "This week";
        return "Earlier";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/notifications.css" asp-append-version="true" />
}

<div class="nt-page @(isNonStudentUser ? "nt-page-portal" : "")">

    @* ─────────────── Header ─────────────── *@
    @if (!isNonStudentUser)
    {
        <section class="nt-hero">
            <span class="nt-hero-aura" aria-hidden="true"></span>
            <div class="nt-hero-inner">
                <span class="nt-hero-ico"><svg class="hgi"><use href="#i-bell"></use></svg></span>
                <div>
                    <h1>Notifications</h1>
                    <p>
                        @if (newCount > 0)
                        {
                            <text><strong>@newCount new</strong> since your last visit · </text>
                        }
                        @notifications.Count total
                    </p>
                </div>
            </div>
        </section>
    }
    else
    {
        @* Always rendered, including when the list is empty — previously the
           count line only appeared when there WERE notifications, so an admin
           with an empty inbox landed on a page with no title at all. *@
        <div class="nt-head">
            <span class="nt-head-ico"><svg class="hgi"><use href="#i-bell"></use></svg></span>
            <div class="nt-head-text">
                <h1>Notifications</h1>
                <p>
                    @if (newCount > 0)
                    {
                        <span class="nt-newcount"><svg class="hgi hgi-sm"><use href="#i-sparkles"></use></svg>@newCount new</span>
                    }
                    @if (notifications.Any())
                    {
                        <text>@notifications.Count notification@(notifications.Count == 1 ? "" : "s")</text>
                    }
                    else
                    {
                        <text>Nothing waiting for you right now</text>
                    }
                </p>
            </div>
        </div>
    }

    @if (!notifications.Any())
    {
        <div class="nt-empty">
            <span class="nt-empty-ico"><svg class="hgi"><use href="#i-bell-off"></use></svg></span>
            <h5>You're all caught up</h5>
            <p>Updates that affect you — a ride request accepted, a ticket answered, a study group change — will land here.</p>
        </div>
    }
    else
    {
        <div class="nt-list">
            @{ string? lastBucket = null; var idx = 0; }
            @foreach (var n in notifications)
            {
                var bucket = Bucket(n.CreatedAt);
                if (bucket != lastBucket)
                {
                    lastBucket = bucket;
                    <p class="nt-bucket">@bucket</p>
                }
                var kind = Kind(n.Link);
                var isNew = newIds.Contains(n.Id);
                idx++;
                var hasLink = !string.IsNullOrWhiteSpace(n.Link);

                <div class="nt-item @(isNew ? "is-new" : "")" style="--i:@idx">
                    <span class="nt-item-ico nt-tone-@kind[1]">
                        <svg class="hgi"><use href="#@kind[0]"></use></svg>
                    </span>
                    <div class="nt-item-body">
                        <div class="nt-item-head">
                            <strong>@n.Title</strong>
                            @if (isNew)
                            {
                                <span class="nt-new-dot" title="New since your last visit"></span>
                            }
                            <time class="nt-item-time" title="@n.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")">@Ago(n.CreatedAt)</time>
                        </div>
                        <p class="nt-item-msg">@n.Message</p>
                        @if (hasLink)
                        {
                            <a href="@n.Link" class="nt-item-link">
                                View details <svg class="hgi hgi-sm"><use href="#i-arrow-right"></use></svg>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
