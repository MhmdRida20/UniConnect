@model List<UniConnect.Controllers.AdminUserUniversityGroup>
@{
    ViewData["Title"] = "Manage Users";
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    var roleNames = ViewBag.RoleNames as Dictionary<string, List<string>> ?? new();
    var currentUserId = ViewBag.CurrentUserId as string;
    var isSuperAdmin = ViewBag.IsSuperAdmin is true;

    var assignableRoles = isSuperAdmin
        ? new[] { "Student", "Instructor", "DepartmentStaff", "UniversityAdmin" }
        : new[] { "Student", "Instructor", "DepartmentStaff" };

    var totalUsers = Model.Sum(g => g.RoleGroups.Sum(rg => rg.Users.Count));

    string RoleGroupLabel(string role) => role switch
    {
        "Student" => "Students",
        "Instructor" => "Instructors",
        "DepartmentStaff" => "Department Staff",
        "UniversityAdmin" => "University Admins",
        "Company" => "Company Accounts",
        "Admin" => "Super Admins",
        _ => role
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/staff-tickets.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        // "Set" stays inert while the dropdown still shows the role the user
        // already has — otherwise clicking it just bounces back an
        // "already has the X role" error, which reads like a failure.
        // uc-select.js re-dispatches `change` on the native <select>, so this
        // works for both the styled listbox and the plain fallback.
        document.querySelectorAll('form[data-role-form]').forEach(function (form) {
            var select = form.querySelector('select[name="newRole"]');
            // Explicit hook: uc-select.js swaps in its own <button class="ucs-trigger">
            // ahead of this one, so a bare 'button' selector would match that instead.
            var button = form.querySelector('button[data-role-set]');
            if (!select || !button) return;

            var sync = function () {
                button.disabled = select.value === select.dataset.currentRole;
            };
            select.addEventListener('change', sync);
            sync();
        });
    </script>
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h2 class="mb-0">Manage Users</h2>
    <span class="text-muted small">@totalUsers user@(totalUsers == 1 ? "" : "s") @(isSuperAdmin ? "across all universities" : "at your university")</span>
</div>

<form method="get" class="d-flex gap-2 mb-4" style="max-width:420px">
    <input type="text" name="search" class="form-control" placeholder="Search by name, email, or ID…" value="@ViewBag.Search" />
    <button class="btn btn-outline-secondary">Search</button>
</form>

@if (!Model.Any())
{
    <div class="uc-empty">
        <span class="uc-empty-icon"><i class="bi bi-people"></i></span>
        <h5>No users found</h5>
    </div>
}

@foreach (var uniGroup in Model)
{
    <div class="mb-4">
        <h4 class="mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-bank"></i> @uniGroup.UniversityName
            <span class="uc-pill uc-pill-grey">@uniGroup.RoleGroups.Sum(rg => rg.Users.Count) user@(uniGroup.RoleGroups.Sum(rg => rg.Users.Count) == 1 ? "" : "s")</span>
        </h4>

        @foreach (var roleGroup in uniGroup.RoleGroups)
        {
            <h6 class="text-muted text-uppercase small mb-2 mt-3" style="letter-spacing:.04em;">
                @RoleGroupLabel(roleGroup.RoleName) <span class="fw-normal">(@roleGroup.Users.Count)</span>
            </h6>

            <div class="st-table mb-2">
                <div class="st-table-head" style="grid-template-columns: 1.2fr 1.1fr .7fr 310px !important;">
                    <span>Name</span>
                    <span>Email</span>
                    <span>Status</span>
                    <span></span>
                </div>
                @foreach (var u in roleGroup.Users)
                {
                    var roles = roleNames.TryGetValue(u.Id, out var r) ? r : new List<string>();
                    var isChangeable = u.Id != currentUserId
                        && !roles.Contains("Admin") && !roles.Contains("Company")
                        && (isSuperAdmin || !roles.Contains("UniversityAdmin"));

                    <div class="st-table-row" style="cursor:default; grid-template-columns: 1.2fr 1.1fr .7fr 310px !important;">
                        <span class="st-title-cell">
                            @u.FullName
                            @if (roleGroup.RoleName == "DepartmentStaff" && !string.IsNullOrWhiteSpace(u.Department))
                            {
                                <span class="uc-pill uc-pill-grey ms-1">@u.Department</span>
                            }
                        </span>
                        <span class="text-muted small">@u.Email</span>
                        @if (u.IsSuspended)
                        {
                            <span class="uc-pill uc-pill-amber">Suspended</span>
                        }
                        else
                        {
                            <span class="uc-pill uc-pill-green">Active</span>
                        }

                        @if (u.Id == currentUserId)
                        {
                            <span class="text-muted small">(you)</span>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-1 justify-content-end">
                                @if (isChangeable)
                                {
                                    @* The dropdown must start on the user's CURRENT role. Without the
                                       `selected` below it always rendered the first option ("Student"),
                                       which made a successful role change look like it hadn't applied —
                                       the row moved into the right group, but the select snapped back. *@
                                    <form asp-action="ChangeRole" method="post" class="d-flex gap-1" data-loading
                                          data-confirm="Change @u.FullName's role?" data-role-form>
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <select name="newRole" class="form-select form-select-sm" style="width:auto;"
                                                data-current-role="@roleGroup.RoleName">
                                            @foreach (var role in assignableRoles)
                                            {
                                                <option value="@role" selected="@(role == roleGroup.RoleName)">@role</option>
                                            }
                                        </select>
                                        @* Not disabled in markup — the script below turns it off until the
                                           value actually changes, so the button still works without JS. *@
                                        <button class="btn btn-outline-secondary btn-sm" data-role-set>Set</button>
                                    </form>
                                }
                                <form asp-action="ToggleSuspend" method="post"
                                      data-confirm="@(u.IsSuspended ? "Reactivate" : "Suspend") @u.FullName's account?">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <button class="btn btn-sm @(u.IsSuspended ? "btn-outline-success" : "btn-outline-danger")">
                                        @(u.IsSuspended ? "Reactivate" : "Suspend")
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}
