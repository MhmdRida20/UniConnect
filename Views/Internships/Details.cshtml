@model UniConnect.Models.Internship
@{
    ViewData["Title"] = Model.Title;
    var score = (int)ViewBag.Score;
    var courseDataAvailable = (bool)ViewBag.CourseDataAvailable;
    var existingApplication = ViewBag.ExistingApplication as UniConnect.Models.InternshipApplication;
    var positionsFilled = (bool)ViewBag.PositionsFilled;
    var deadlinePassed = (bool)ViewBag.DeadlinePassed;
    var hasCv = ViewBag.HasCv is true;
    var skillCount = (int)(ViewBag.SkillCount ?? 0);
    var mailtoSubject = Uri.EscapeDataString($"Application for {Model.Title}");

    var scoreTone = score >= 70 ? "high" : score >= 40 ? "mid" : "low";
    var scoreLabel = score >= 70 ? "Strong match" : score >= 40 ? "Partial match" : "Low match";

    var daysLeft = (Model.ApplicationDeadline.Date - DateTime.Today).Days;
    var deadlineUrgent = !deadlinePassed && daysLeft <= 7;

    string[] Split(string? csv) => string.IsNullOrWhiteSpace(csv)
        ? Array.Empty<string>()
        : csv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/internships.css" asp-append-version="true" />
}

<div class="idt-page">
    <a asp-action="Index" class="idt-back">
        <svg class="hgi hgi-sm"><use href="#i-arrow-left"></use></svg>Back to internships
    </a>

    @* ─────────────── Hero ─────────────── *@
    <section class="idt-hero">
        <span class="idt-hero-aura" aria-hidden="true"></span>
        <div class="idt-hero-inner">
            <div class="idt-hero-text">
                <span class="idt-employer">
                    <svg class="hgi hgi-sm"><use href="#i-building"></use></svg>@Model.ExternalEmployerName
                </span>
                <h1>@Model.Title</h1>
                <span class="idt-posted">Posted by @Model.Company?.CompanyName</span>
            </div>

            <div class="idt-score idt-score-@scoreTone" style="--pct:@score">
                <div class="idt-score-ring">
                    <span class="idt-score-num">@score<small>%</small></span>
                </div>
                <span class="idt-score-label">@scoreLabel</span>
            </div>
        </div>

        @if (!courseDataAvailable)
        {
            <p class="idt-score-note">
                <svg class="hgi hgi-sm"><use href="#i-info"></use></svg>
                Partial score — course data is unavailable right now.
            </p>
        }
    </section>

    @* ─────────────── Key facts ─────────────── *@
    <div class="idt-meta">
        <div class="idt-meta-card">
            <span class="idt-meta-ico"><svg class="hgi"><use href="#i-location"></use></svg></span>
            <div><small>Location</small><strong>@Model.Location</strong></div>
        </div>
        <div class="idt-meta-card">
            <span class="idt-meta-ico"><svg class="hgi"><use href="#i-clock"></use></svg></span>
            <div><small>Duration</small><strong>@(Model.DurationWeeks.HasValue ? Model.DurationWeeks + " weeks" : "Not specified")</strong></div>
        </div>
        <div class="idt-meta-card @(deadlineUrgent ? "is-urgent" : "")">
            <span class="idt-meta-ico"><svg class="hgi"><use href="#i-calendar"></use></svg></span>
            <div>
                <small>Deadline</small>
                <strong>@Model.ApplicationDeadline.ToString("MMM dd, yyyy")</strong>
                @if (deadlinePassed)
                {
                    <em class="idt-meta-flag">Closed</em>
                }
                else if (daysLeft == 0)
                {
                    <em class="idt-meta-flag">Last day</em>
                }
                else if (deadlineUrgent)
                {
                    <em class="idt-meta-flag">@daysLeft day@(daysLeft == 1 ? "" : "s") left</em>
                }
            </div>
        </div>
        <div class="idt-meta-card">
            <span class="idt-meta-ico"><svg class="hgi"><use href="#i-users"></use></svg></span>
            <div><small>Positions</small><strong>@Model.NumberOfPositions</strong></div>
        </div>
    </div>

    @* ─────────────── Description + requirements ─────────────── *@
    <section class="idt-card">
        <h2 class="idt-section-title"><svg class="hgi hgi-sm"><use href="#i-file"></use></svg>About this role</h2>
        <p class="idt-desc">@Model.Description</p>

        @{
            var skills = Split(Model.RequiredSkills);
            var courses = Split(Model.RecommendedCourses);
            var majors = Split(Model.RelevantMajors);
        }

        @if (skills.Length > 0 || courses.Length > 0 || majors.Length > 0)
        {
            <div class="idt-reqs">
                @if (skills.Length > 0)
                {
                    <div class="idt-req-group">
                        <h3><svg class="hgi hgi-sm"><use href="#i-tag"></use></svg>Required skills</h3>
                        <div class="idt-chips">
                            @foreach (var s in skills)
                            {
                                <span class="idt-chip">@s</span>
                            }
                        </div>
                    </div>
                }
                @if (courses.Length > 0)
                {
                    <div class="idt-req-group">
                        <h3><svg class="hgi hgi-sm"><use href="#i-book"></use></svg>Recommended courses</h3>
                        <div class="idt-chips">
                            @foreach (var c in courses)
                            {
                                <span class="idt-chip idt-chip-blue">@c</span>
                            }
                        </div>
                    </div>
                }
                @if (majors.Length > 0)
                {
                    <div class="idt-req-group">
                        <h3><svg class="hgi hgi-sm"><use href="#i-graduation"></use></svg>Relevant majors</h3>
                        <div class="idt-chips">
                            @foreach (var m in majors)
                            {
                                <span class="idt-chip idt-chip-purple">@m</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    @* ─────────────── Apply ─────────────── *@
    <section class="idt-card idt-apply">
        @if (Model.PostingMode == UniConnect.Models.InternshipPostingMode.ListingOnly)
        {
            <h2 class="idt-section-title"><svg class="hgi hgi-sm"><use href="#i-external"></use></svg>How to apply</h2>
            <div class="idt-note idt-note-info">
                <svg class="hgi hgi-sm"><use href="#i-info"></use></svg>
                <span>This employer handles applications directly — UniConnect doesn't track your application status for this listing.</span>
            </div>
            <div class="idt-apply-actions">
                @if (!string.IsNullOrWhiteSpace(Model.ExternalApplyUrl))
                {
                    <a href="@Model.ExternalApplyUrl" target="_blank" rel="noopener noreferrer" class="btn btn-primary idt-btn">
                        <svg class="hgi hgi-sm"><use href="#i-external"></use></svg>Apply on employer's website
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ExternalApplyEmail))
                {
                    <a href="mailto:@Model.ExternalApplyEmail?subject=@mailtoSubject" class="btn btn-outline-primary idt-btn">
                        <svg class="hgi hgi-sm"><use href="#i-mail"></use></svg>Apply by email
                    </a>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.ExternalApplyEmail))
            {
                <div class="idt-copyrow">
                    <span>No mail app opened? Send to</span>
                    <code id="applyEmailText">@Model.ExternalApplyEmail</code>
                    <button type="button" class="idt-copy-btn" id="copyEmailBtn" title="Copy email address">
                        <svg class="hgi hgi-sm"><use href="#i-copy"></use></svg><span>Copy</span>
                    </button>
                </div>
            }
        }
        else if (existingApplication is not null)
        {
            <h2 class="idt-section-title"><svg class="hgi hgi-sm"><use href="#i-check-circle"></use></svg>Your application</h2>
            <div class="idt-note idt-note-ok">
                <svg class="hgi hgi-sm"><use href="#i-check-circle"></use></svg>
                <span>
                    You applied on <strong>@existingApplication.AppliedAt.ToLocalTime().ToString("MMM dd, yyyy")</strong> —
                    status: <span class="uc-pill status-@existingApplication.Status.ToString().ToLowerInvariant()">@existingApplication.Status</span>
                </span>
            </div>
            <a asp-action="MyApplications" class="idt-link">
                Track all my applications <svg class="hgi hgi-sm"><use href="#i-arrow-right"></use></svg>
            </a>
        }
        else if (deadlinePassed)
        {
            <div class="idt-note idt-note-muted">
                <svg class="hgi hgi-sm"><use href="#i-calendar"></use></svg>
                <span>The application deadline has passed.</span>
            </div>
        }
        else if (positionsFilled)
        {
            <div class="idt-note idt-note-muted">
                <svg class="hgi hgi-sm"><use href="#i-users"></use></svg>
                <span>All positions for this internship have been filled.</span>
            </div>
        }
        else
        {
            <h2 class="idt-section-title"><svg class="hgi hgi-sm"><use href="#i-send"></use></svg>Apply for this role</h2>

            @* Readiness checklist — makes the CV/skills gap actionable instead of a wall of warning text. *@
            <div class="idt-ready">
                <div class="idt-ready-item @(hasCv ? "is-ok" : "is-missing")">
                    <svg class="hgi hgi-sm"><use href="@(hasCv ? "#i-check-circle" : "#i-alert")"></use></svg>
                    <span>@(hasCv ? "CV uploaded" : "No CV uploaded")</span>
                </div>
                <div class="idt-ready-item @(skillCount > 0 ? "is-ok" : "is-missing")">
                    <svg class="hgi hgi-sm"><use href="@(skillCount > 0 ? "#i-check-circle" : "#i-alert")"></use></svg>
                    <span>@(skillCount > 0 ? $"{skillCount} skill{(skillCount == 1 ? "" : "s")} listed" : "No skills listed")</span>
                </div>
                @if (!hasCv || skillCount == 0)
                {
                    <a asp-controller="CareerProfile" asp-action="Index" class="idt-ready-fix">
                        Update profile <svg class="hgi hgi-sm"><use href="#i-arrow-right"></use></svg>
                    </a>
                }
            </div>

            @if (!hasCv || skillCount == 0)
            {
                <div class="idt-note idt-note-warn">
                    <svg class="hgi hgi-sm"><use href="#i-info"></use></svg>
                    <span>
                        @if (!hasCv && skillCount == 0)
                        {
                            <text>The employer won't see a CV or any skills if you apply now.</text>
                        }
                        else if (!hasCv)
                        {
                            <text>Your CV won't be included if the employer receives your application.</text>
                        }
                        else
                        {
                            <text>Adding skills may raise your matching score.</text>
                        }
                        You can still apply below.
                    </span>
                </div>
            }

            <form asp-action="Apply" method="post" data-loading>
                @Html.AntiForgeryToken()
                <input type="hidden" name="internshipId" value="@Model.Id" />
                <label class="form-label" for="coverMessage">Cover message <span class="text-muted">(optional)</span></label>
                <textarea id="coverMessage" name="coverMessage" class="form-control mb-3" rows="4"
                          maxlength="1000" placeholder="Why are you a good fit for this role?"></textarea>
                <button class="btn btn-primary idt-btn idt-btn-submit" data-loading-text="Sending…">
                    <svg class="hgi hgi-sm"><use href="#i-send"></use></svg>Submit application
                </button>
            </form>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/pages/internship-details.js" asp-append-version="true"></script>
}
