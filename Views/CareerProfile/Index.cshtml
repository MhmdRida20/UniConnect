@model UniConnect.ViewModels.CareerProfileEditVM
@{
    ViewData["Title"] = "Career Profile";
    var skills = ViewBag.Skills as List<UniConnect.Models.StudentSkill> ?? new();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/form-page.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/internships.css" asp-append-version="true" />
}

<div class="uc-hero uc-hero-compact">
    <div class="uc-hero-inner">
        <p class="uc-eyebrow"><i class="bi bi-person-badge"></i>Internships</p>
        <h1 class="uc-hero-title mb-0">My Career Profile</h1>
    </div>
</div>

<div class="container form-page" style="padding-top:1.25rem;">
<div class="form-page-split">
<div class="form-main">
    <div class="uc-form-card mb-3">
        <h3 class="mb-3">Profile Details</h3>
        <p class="text-muted small mb-3">
            <i class="bi bi-info-circle"></i> This button only saves the fields below.
            Skills and your CV (further down) each have their own save step —
            you don't need to come back here afterward.
        </p>
        <form asp-action="Edit" method="post" data-loading id="careerProfileForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="CareerInterests" class="form-label"></label>
                <textarea asp-for="CareerInterests" class="form-control" rows="2" placeholder="e.g. backend development, data analysis, marketing"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="CareerGoals" class="form-label"></label>
                <textarea asp-for="CareerGoals" class="form-control" rows="2"></textarea>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="PreferredLocation" class="form-label"></label>
                    <input asp-for="PreferredLocation" class="form-control" placeholder="e.g. Beirut" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Availability" class="form-label"></label>
                    <input asp-for="Availability" class="form-control" placeholder="e.g. Summer 2026, full-time" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-3"><i class="bi bi-check-lg me-1"></i>Save Profile Details</button>
        </form>
    </div>

    @* Adds and removals are staged in the browser and posted together by
       #skillsBatchForm. The per-skill AddSkill/RemoveSkill forms below are
       still real, working forms — they're the no-JS fallback, and
       career-skills.js intercepts them when it loads. *@
    <div class="uc-form-card mb-3" id="skillsCard">
        <h3 class="mb-3">Skills</h3>
        <p class="text-muted small mb-2" data-skills-hint="js" hidden>
            <i class="bi bi-lightning-charge"></i> Add as many as you like — they're saved together when you click <strong>Save skills</strong>.
        </p>
        <p class="text-muted small mb-2" data-skills-hint="nojs">
            <i class="bi bi-lightning-charge"></i> Each skill saves immediately when you click "Add".
        </p>

        <div class="d-flex flex-wrap gap-2 mb-3" id="skillChips">
            @foreach (var s in skills)
            {
                <span class="skill-chip" data-skill-id="@s.Id" data-skill-name="@s.SkillName">
                    @s.SkillName
                    @if (s.ProficiencyLevel.HasValue)
                    {
                        <small>(@s.ProficiencyLevel)</small>
                    }
                    <form asp-action="RemoveSkill" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@s.Id" />
                        <button class="skill-chip-remove" title="Remove">&times;</button>
                    </form>
                </span>
            }
            <p class="text-muted small mb-0" id="skillsEmpty" @(skills.Any() ? "hidden" : "")>No skills added yet.</p>
        </div>

        <form asp-action="AddSkill" method="post" class="d-flex gap-2" data-loading id="skillAddForm">
            @Html.AntiForgeryToken()
            <input type="text" name="skillName" class="form-control" placeholder="Add a skill, e.g. C#" maxlength="100" required />
            <select name="proficiencyLevel" class="form-select" style="max-width:160px">
                <option value="">Level (optional)</option>
                <option value="Beginner">Beginner</option>
                <option value="Intermediate">Intermediate</option>
                <option value="Advanced">Advanced</option>
            </select>
            <button class="btn btn-outline-primary">Add</button>
        </form>

        @* Unhidden by career-skills.js as soon as there is something staged. *@
        <form asp-action="SaveSkills" method="post" data-loading id="skillsBatchForm" hidden>
            @Html.AntiForgeryToken()
            <div class="skills-save-bar">
                <span class="skills-save-summary" id="skillsSummary"></span>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="skillsDiscard">Discard</button>
                <button type="submit" class="btn btn-primary btn-sm" data-loading-text="Saving…">
                    <i class="bi bi-check-lg me-1"></i>Save skills
                </button>
            </div>
            <div id="skillsBatchInputs" hidden></div>
        </form>
    </div>

    <div class="uc-form-card">
        <h3 class="mb-3">CV</h3>
        <p class="text-muted small mb-2"><i class="bi bi-lightning-charge"></i> Uploads immediately once you choose a file — no separate save step needed.</p>
        @if (!string.IsNullOrWhiteSpace(ViewBag.CvFileName as string))
        {
            <p><i class="bi bi-file-earmark-text me-1"></i>@ViewBag.CvFileName</p>
            <form asp-action="DeleteCv" method="post" data-confirm="Remove your CV?" class="d-inline">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-danger btn-sm">Remove CV</button>
            </form>
        }
        else
        {
            <p class="text-muted small">No CV uploaded yet.</p>
        }
        <form asp-action="UploadCv" method="post" enctype="multipart/form-data" class="d-flex gap-2 mt-2" data-loading id="cvUploadForm">
            @Html.AntiForgeryToken()
            <input type="file" name="cv" id="cvFileInput" class="form-control" accept=".pdf,.doc,.docx" data-max-mb="5" required />
            <button class="btn btn-outline-primary" id="cvUploadButton">Upload</button>
        </form>
        <small class="text-muted d-block mt-1">PDF or Word document, max 5 MB. Uploads as soon as you pick a file.</small>
    </div>
</div>

<aside class="form-rail">
    @* Tracks every field, not just required ones: nothing here is mandatory,
       but a fuller profile scores measurably higher against internships. *@
    <partial name="_FormProgress" model='new UniConnect.ViewModels.FormProgressVM {
        Title = "Profile strength", Subtitle = "Drives your match scores", Icon = "#i-target",
        FormSelector = "#careerProfileForm", TrackAllFields = true, Label = "Completed",
        CompleteMessage = "Profile details complete — add skills and a CV below to score higher." }' />

    <div class="form-aside">
        <h2><svg class="hgi"><use href="#i-idea"></use></svg>Why this matters</h2>
        <ul>
            <li><strong>This feeds your match score.</strong> Every internship shows a percentage calculated from what's here.</li>
            <li><strong>Skills carry the most weight.</strong> Add as many as you like, then save them in one go.</li>
            <li><strong>Employers see your CV.</strong> Applications without one are far weaker.</li>
            <li><strong>Be specific about interests.</strong> "Backend development" matches better than "technology".</li>
        </ul>
    </div>
</aside>
</div>
</div>

@section Scripts {
    <script src="~/js/form-progress.js" asp-append-version="true"></script>
    <script src="~/js/pages/career-profile-cv.js" asp-append-version="true"></script>
    <script src="~/js/pages/career-skills.js" asp-append-version="true"></script>
}
