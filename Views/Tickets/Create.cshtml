@model UniConnect.ViewModels.TicketCreateVM
@{
    ViewData["Title"] = "Submit a Ticket";
    var showDuplicateWarning = ViewBag.DuplicateWarning is true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/form-page.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/tickets.css" asp-append-version="true" />
}

<div class="form-page">
    <a asp-action="Index" class="form-back"><svg class="hgi hgi-sm"><use href="#i-arrow-left"></use></svg>Back to my tickets</a>

    <div class="form-page-head">
        <span class="form-page-ico"><svg class="hgi"><use href="#i-ticket"></use></svg></span>
        <div>
            <h1>Submit a Ticket</h1>
            <p class="text-muted">Tell us what's going on and we'll route it to the right department.</p>
        </div>
    </div>

    <div class="form-page-split">
        <div class="form-main">
            <div class="uc-form-card">
                <form asp-action="Create" method="post" enctype="multipart/form-data" data-loading>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    @if (showDuplicateWarning)
                    {
                        <div class="alert alert-warning d-flex align-items-start gap-2">
                            <svg class="hgi hgi-sm mt-1"><use href="#i-alert"></use></svg>
                            <div>
                                <strong>Looks similar to a recent ticket.</strong>
                                <p class="mb-2">
                                    You submitted a ticket with the same title and category in the last 24 hours.
                                    If this is a new issue, you can go ahead and submit anyway.
                                </p>
                                <input type="hidden" name="ConfirmDuplicate" value="true" />
                                <button type="submit" class="btn btn-sm btn-warning" formnovalidate>
                                    Submit anyway
                                </button>
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" asp-items="Model.AvailableCategories" class="form-select">
                            <option value="">— Select a category —</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Can't access WiFi in Building C" autofocus />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="5" maxlength="2000" placeholder="Give as much detail as you can…"></textarea>
                        <div class="d-flex justify-content-end">
                            <small class="form-text" id="descCount">0 / 2000</small>
                        </div>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Priority</label>
                        <div class="ticket-priority-picker">
                            @foreach (var p in Enum.GetValues<UniConnect.Models.TicketPriority>())
                            {
                                <label class="ticket-priority-option priority-@p.ToString().ToLower()">
                                    @if (p == Model.Priority)
                                    {
                                        <input type="radio" name="Priority" value="@p" checked="checked" />
                                    }
                                    else
                                    {
                                        <input type="radio" name="Priority" value="@p" />
                                    }
                                    <span>@p</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Attachment" class="form-label">Attachment <span class="text-muted fw-normal">(optional, max 5 MB)</span></label>
                        <input asp-for="Attachment" type="file" class="form-control" accept=".pdf,.png,.jpg,.jpeg,.docx,.txt" data-max-mb="5" />
                        <span asp-validation-for="Attachment" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100" data-loading-text="Submitting…">
                        <svg class="hgi hgi-sm me-1"><use href="#i-send"></use></svg>Submit Ticket
                    </button>
                </form>
            </div>
        </div>

        <aside class="form-rail">
            <partial name="_FormProgress" model='new UniConnect.ViewModels.FormProgressVM {
                Title = "New Ticket", Subtitle = "Support request", Icon = "#i-ticket" }' />

            <div class="form-aside">
                <h2><svg class="hgi"><use href="#i-idea"></use></svg>Get a faster response</h2>
                <ul>
                    <li><strong>Pick the right category.</strong> It routes your ticket straight to the department that can fix it.</li>
                    <li><strong>Be specific in the title.</strong> "Can't access WiFi in Building C" beats "WiFi issue."</li>
                    <li><strong>Add details.</strong> When it started, what you've tried, and any error messages help a lot.</li>
                    <li><strong>Attach evidence.</strong> A screenshot or document can save a back-and-forth.</li>
                </ul>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-progress.js" asp-append-version="true"></script>
    <script src="~/js/pages/form-page.js" asp-append-version="true"></script>
}
