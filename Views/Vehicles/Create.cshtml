@model UniConnect.ViewModels.VehicleCreateVM
@{
    ViewData["Title"] = "Register Vehicle";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/form-page.css" asp-append-version="true" />
}

<div class="form-page">
    <a asp-action="Index" class="form-back"><svg class="hgi hgi-sm"><use href="#i-arrow-left"></use></svg>Back to my vehicles</a>

    <div class="form-page-head">
        <span class="form-page-ico"><svg class="hgi"><use href="#i-car"></use></svg></span>
        <div>
            <h1>Register a Vehicle</h1>
            <p class="text-muted">Do this once — then pick it whenever you offer a ride.</p>
        </div>
    </div>

    <div class="form-page-split">
        <div class="form-main">
            <div class="uc-form-card">
                <form asp-action="Create" method="post" data-loading>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="VehicleType" class="form-label"></label>
                        <select asp-for="VehicleType" class="form-select" autofocus>
                            <option value="">-- Select --</option>
                            <option>Sedan</option>
                            <option>SUV</option>
                            <option>Hatchback</option>
                            <option>Van</option>
                            <option>Motorcycle</option>
                        </select>
                        <span asp-validation-for="VehicleType" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="PlateNumber" class="form-label"></label>
                            <input asp-for="PlateNumber" class="form-control" placeholder="e.g. 123456" />
                            <span asp-validation-for="PlateNumber" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Color" class="form-label"></label>
                            <input asp-for="Color" class="form-control" placeholder="e.g. White" />
                            <span asp-validation-for="Color" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 mt-3">
                        <label asp-for="SeatCapacity" class="form-label"></label>
                        <input asp-for="SeatCapacity" type="number" min="1" max="8" class="form-control" style="max-width:160px" />
                        <span asp-validation-for="SeatCapacity" class="text-danger"></span>
                        <small class="text-muted d-block mt-1">This caps how many seats you can offer on any ride using this vehicle.</small>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mt-2" data-loading-text="Registering…">
                        <svg class="hgi hgi-sm me-1"><use href="#i-check-circle"></use></svg>Register Vehicle
                    </button>
                </form>
            </div>
        </div>

        <aside class="form-rail">
            <partial name="_FormProgress" model='new UniConnect.ViewModels.FormProgressVM {
                Title = "New Vehicle", Subtitle = "For ride sharing", Icon = "#i-car" }' />

            <div class="form-aside">
                <h2><svg class="hgi"><use href="#i-idea"></use></svg>Before you register</h2>
                <ul>
                    <li><strong>Match your plate exactly.</strong> Riders may check it against yours when meeting up.</li>
                    <li><strong>Set a real seat count.</strong> It's the hard limit on how many seats you can offer per ride.</li>
                    <li><strong>Register more than one.</strong> You can add every vehicle you drive and pick one per ride.</li>
                </ul>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-progress.js" asp-append-version="true"></script>
}
