@model UniConnect.ViewModels.UniversityCreateVM
@{
    ViewData["Title"] = "Add University";
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/form-page.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin-universities.css" asp-append-version="true" />
}

<a asp-action="Index" class="form-back mb-3 d-inline-flex align-items-center gap-1">
    <svg class="hgi hgi-sm"><use href="#i-arrow-left"></use></svg>Back to universities
</a>

<div class="au-create-layout">
    <div class="uc-form-card au-form-card">
        <form asp-action="Create" method="post" data-loading>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <div class="uc-input-icon">
                    <svg class="hgi hgi-sm"><use href="#i-building"></use></svg>
                    <input asp-for="Name" class="form-control" placeholder="e.g. American University of Beirut" />
                </div>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Code" class="form-label"></label>
                <div class="uc-input-icon">
                    <svg class="hgi hgi-sm"><use href="#i-id"></use></svg>
                    <input asp-for="Code" class="form-control" placeholder="e.g. AUB" style="text-transform:uppercase" />
                </div>
                <small class="text-muted">A short unique code — used internally to identify this university.</small>
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ApiStyle" class="form-label"></label>
                <select asp-for="ApiStyle" id="ApiStyleSelect" class="form-select">
                    <option value="Simulated">Simulated — this project's own built-in test API (default; use "Generate" below)</option>
                    <option value="Ums">Real external API — university's own read-only API (paste their API key below)</option>
                </select>
                <small class="text-muted d-block mt-1">
                    Choose "Real external API" for an actual university partner's own system — their field names and
                    endpoints are different from the simulator, and get handled by a separate adapter automatically
                    from here on. Course/roster auto-sync isn't available for this option yet; student registration,
                    enrollment checks, and attendance all still work — they call the university's API live instead.
                </small>
            </div>

            <div class="mb-3" id="apiUrlField">
                <label asp-for="ApiBaseUrl" class="form-label"></label>
                <div class="uc-input-icon">
                    <svg class="hgi hgi-sm"><use href="#i-cloud-sync"></use></svg>
                    <input asp-for="ApiBaseUrl" class="form-control" placeholder="https://api.example-university.edu" />
                </div>
                <span asp-validation-for="ApiBaseUrl" class="text-danger"></span>
                @* Style-dependent, because this field genuinely means different
                   things: the simulator is addressed at its versioned path, while
                   the real adapter appends "v1/" itself and needs the bare host.
                   A single hint showing the /v1 form taught people to paste a
                   path that produces 404 on every call. *@
                <small class="text-muted d-block mt-1" id="apiUrlHint"></small>

                <label asp-for="ApiKey" class="form-label mt-3"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><svg class="hgi hgi-sm text-muted"><use href="#i-shield"></use></svg></span>
                    <input asp-for="ApiKey" id="ApiKeyInput" class="form-control" placeholder="Click Generate, or paste a real API key" />
                    <button type="button" class="btn btn-outline-secondary" id="generateApiKeyBtn" data-url="@Url.Action("GenerateApiKey", "AdminUniversities")">
                        <svg class="hgi hgi-sm me-1"><use href="#i-magic"></use></svg>Generate
                    </button>
                </div>
                <span asp-validation-for="ApiKey" class="text-danger"></span>
                <small class="text-muted d-block mt-1" id="apiKeyHint">
                    Generates a unique key AND provisions a fresh, independent set of at least 5 students (each enrolled
                    in at least 4 courses) for it — every university gets its own data, never shared with another.
                </small>
            </div>

            <div class="mb-3">
                <label asp-for="CareerServicesEmail" class="form-label"></label>
                <div class="uc-input-icon">
                    <svg class="hgi hgi-sm"><use href="#i-mail"></use></svg>
                    <input asp-for="CareerServicesEmail" class="form-control" placeholder="careers@university.edu" />
                </div>
                <span asp-validation-for="CareerServicesEmail" class="text-danger"></span>
                <small class="text-muted d-block mt-1">
                    Creates this university's internship-posting login automatically, using this real address —
                    a one-time password will be shown after you submit, so save it before navigating away.
                </small>
            </div>

            <div class="mb-3">
                <label asp-for="UniversityAdminEmail" class="form-label"></label>
                <div class="uc-input-icon">
                    <svg class="hgi hgi-sm"><use href="#i-mail"></use></svg>
                    <input asp-for="UniversityAdminEmail" class="form-control" placeholder="admin@university.edu" />
                </div>
                <span asp-validation-for="UniversityAdminEmail" class="text-danger"></span>
                <small class="text-muted d-block mt-1">
                    Creates this university's own scoped admin login — can manage this university's services,
                    users, and reports, but not any other university on the platform.
                </small>
            </div>

            <button type="submit" class="btn btn-primary w-100" data-loading-text="Adding…">
                <svg class="hgi hgi-sm me-1"><use href="#i-plus"></use></svg>Add University
            </button>
        </form>
    </div>

    <aside class="au-rail">
        <partial name="_FormProgress" model='new UniConnect.ViewModels.FormProgressVM {
            Title = "New University", Subtitle = "Platform onboarding", Icon = "#i-building" }' />

        <div class="au-whathappens">
            <h3><svg class="hgi hgi-sm"><use href="#i-info"></use></svg>What happens next</h3>
        <ol>
            <li>
                <span class="au-wh-ico"><svg class="hgi"><use href="#i-cloud-sync"></use></svg></span>
                <div>
                    <strong>Immediate sync</strong>
                    <small>UniConnect calls this university's API right away, so you see whether the connection works without waiting for the next scheduled cycle.</small>
                </div>
            </li>
            <li>
                <span class="au-wh-ico"><svg class="hgi"><use href="#i-briefcase"></use></svg></span>
                <div>
                    <strong>Career services login created</strong>
                    <small>A one-time password is generated for the internship-posting account — you'll only see it once, right after submitting.</small>
                </div>
            </li>
            <li>
                <span class="au-wh-ico"><svg class="hgi"><use href="#i-customize"></use></svg></span>
                <div>
                    <strong>Choose services next</strong>
                    <small>You'll land on the service catalog for this university — nothing is visible to its students or staff until you enable it there.</small>
                </div>
            </li>
            </ol>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-progress.js" asp-append-version="true"></script>
    <script src="~/js/pages/admin-universities.js" asp-append-version="true"></script>
    <script>
        // Adjusts the API Key field's hint + hides "Generate" for a real
        // external university — Generate only makes sense for this project's
        // own simulator, since it provisions fake data alongside the key.
        (function () {
            const styleSelect = document.getElementById('ApiStyleSelect');
            const generateBtn = document.getElementById('generateApiKeyBtn');
            const hint = document.getElementById('apiKeyHint');
            const keyInput = document.getElementById('ApiKeyInput');

            const simulatedHint = 'Generates a unique key AND provisions a fresh, independent set of at least 5 students (each enrolled ' +
                'in at least 4 courses) for it — every university gets its own data, never shared with another.';
            const realHint = 'Paste the API key the university gave you directly — there is nothing to generate here.';

            const urlHint = document.getElementById('apiUrlHint');
            const urlInput = document.querySelector('[name="ApiBaseUrl"]');

            const simulatedUrlHint = 'No real university API to point at yet? This project includes a working simulated one — use ' +
                window.location.origin + '/external-api/v1 to try the integration end-to-end.';
            // The adapter sets this as the HttpClient BaseAddress and then requests
            // "v1/courses", "v1/students/…" itself, so anything beyond the host
            // becomes a prefix on every call — a Swagger UI address gives 404.
            const realUrlHint = 'Enter the API root only, with no path — e.g. http://85.112.66.69:809. ' +
                'Do not include /v1 or /swagger: UniConnect adds the version and endpoint to every request itself.';

            function applyStyle() {
                const isReal = styleSelect.value === 'Ums';
                generateBtn.style.display = isReal ? 'none' : '';
                hint.textContent = isReal ? realHint : simulatedHint;
                keyInput.placeholder = isReal ? 'Paste the real API key here' : 'Click Generate →';

                urlHint.textContent = isReal ? realUrlHint : simulatedUrlHint;
                if (urlInput) {
                    urlInput.placeholder = isReal
                        ? 'http://host:port'
                        : window.location.origin + '/external-api/v1';
                }
            }

            styleSelect.addEventListener('change', applyStyle);
            applyStyle(); // run once on load in case the browser restored a previous selection
        })();
    </script>
}
