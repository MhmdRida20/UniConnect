@model UniConnect.ViewModels.ClubEventCreateVM
@{
    var club = ViewBag.Club as UniConnect.Models.Club;
    ViewData["Title"] = "Create Event";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/form-page.css" asp-append-version="true" />
}

<div class="form-page">
    <a asp-action="Details" asp-route-id="@club?.Id" class="form-back">
        <svg class="hgi hgi-sm"><use href="#i-arrow-left"></use></svg>Back to @club?.ClubName
    </a>

    <div class="form-page-head">
        <span class="form-page-ico"><svg class="hgi"><use href="#i-calendar"></use></svg></span>
        <div>
            <h1>Create Event</h1>
            <p class="text-muted">For @club?.ClubName</p>
        </div>
    </div>

    <div class="form-page-split">
        <div class="form-main">
            <div class="uc-form-card">
                <form asp-action="CreateEvent" asp-route-clubId="@club?.Id" method="post" data-loading>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Intro to AI Workshop" autofocus />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"
                                  placeholder="What's happening, and who should come?"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EventDateTime" class="form-label"></label>
                        <input asp-for="EventDateTime" class="form-control" />
                        <span asp-validation-for="EventDateTime" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Location" class="form-label"></label>
                        <div class="input-icon">
                            <svg class="hgi hgi-sm"><use href="#i-location"></use></svg>
                            <input asp-for="Location" class="form-control" placeholder="e.g. Main Auditorium" />
                        </div>
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaxAttendees" class="form-label"></label>
                        <input asp-for="MaxAttendees" type="number" class="form-control" placeholder="Leave blank for unlimited" />
                        <span asp-validation-for="MaxAttendees" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100" data-loading-text="Creating…">
                        <svg class="hgi hgi-sm me-1"><use href="#i-plus"></use></svg>Create Event
                    </button>
                </form>
            </div>
        </div>

        <aside class="form-rail">
            <partial name="_FormProgress" model='new UniConnect.ViewModels.FormProgressVM {
                Title = "New Event", Subtitle = "Club event", Icon = "#i-calendar" }' />

            <div class="form-aside">
                <h2><svg class="hgi"><use href="#i-idea"></use></svg>Tips for a good turnout</h2>
                <ul>
                    <li><strong>Say what it is up front.</strong> A concrete title beats a clever one for getting RSVPs.</li>
                    <li><strong>Give people notice.</strong> Events posted a week ahead fill far better than same-day ones.</li>
                    <li><strong>Be exact about the place.</strong> Include the building and room, not just the campus.</li>
                    <li><strong>Cap only if you must.</strong> Leave attendees blank unless the room genuinely limits you.</li>
                </ul>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-progress.js" asp-append-version="true"></script>
    <script src="~/js/pages/form-page.js" asp-append-version="true"></script>
}
