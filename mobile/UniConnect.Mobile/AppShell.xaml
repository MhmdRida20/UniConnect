<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="UniConnect.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:UniConnect.Mobile.Pages"
    Title="UniConnect"
    FlyoutBehavior="Disabled">

    <!--
        One ShellItem per top-level section rather than ShellContents inside a
        single item, so Shell treats them as independent and does not draw a tab
        bar of its own across them — the app draws its own. Switching with an
        absolute route ("//home") replaces the whole navigation stack, which is
        what sign-in, sign-out and every tab tap want: no back button from a
        section to the one before it, and none from the dashboard to login.

        Every route the app navigates to with "//" needs an entry here. A
        missing one does not fail the build — it fails at the moment of
        navigation, which is how a merge once left sign-in pointing at a "//home"
        that no longer existed.
    -->

    <ShellItem Route="login">
        <ShellContent ContentTemplate="{DataTemplate pages:LoginPage}" />
    </ShellItem>

    <ShellItem Route="home">
        <ShellContent ContentTemplate="{DataTemplate pages:HomePage}" />
    </ShellItem>

    <ShellItem Route="groups">
        <ShellContent ContentTemplate="{DataTemplate pages:GroupsPage}" />
    </ShellItem>

    <ShellItem Route="internships">
        <ShellContent ContentTemplate="{DataTemplate pages:InternshipsPage}" />
    </ShellItem>

    <!-- A section rather than a pushed route because it owns a tab: tapping a
         tab has to replace the stack, not push onto the stack of whichever
         section you happened to be in. -->
    <ShellItem Route="attendance">
        <ShellContent ContentTemplate="{DataTemplate pages:AttendancePage}" />
    </ShellItem>

    <ShellItem Route="rides">
        <ShellContent ContentTemplate="{DataTemplate pages:RidesPage}" />
    </ShellItem>

</Shell>
