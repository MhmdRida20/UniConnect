<?xml version="1.0" encoding="utf-8" ?>
<!--
    My Attendance.

    Same shape as the other sections: a fixed app bar and tab bar with one
    scrolling surface between them. No FAB — the primary action ("Check In") is
    prominent enough in the body that a floating button would be redundant,
    unlike Groups where "create" is distinct from anything already on screen.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UniConnect.Mobile.Pages.AttendancePage"
             Title="My Attendance"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ===== Top app bar — the same three elements as every other section:
             account avatar left, brand centre, notifications right. ===== -->
        <Border Grid.Row="0" Style="{StaticResource UcAppBar}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                <Border
                    Grid.Column="0"
                    Background="{StaticResource UcAvatarBrush}"
                    Stroke="{StaticResource UcMint}"
                    StrokeThickness="2"
                    HeightRequest="38" WidthRequest="38"
                    VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19" />
                    </Border.StrokeShape>
                    <!-- The photo is layered over the monogram, so the initials
                         show until a picture exists and again if it is removed. -->
                    <Grid>
                        <Label
                            x:Name="ProfileInitials"
                            Style="{StaticResource UcAvatarText}"
                            FontSize="13" />
                        <Image
                            x:Name="ProfilePhoto"
                            IsVisible="False"
                            Aspect="AspectFill"
                            HeightRequest="38" WidthRequest="38" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <Label Grid.Column="1" Text="UniConnect" Style="{StaticResource UcAppBarTitle}" />

                <!-- 44x44 with the icon centred inside it: a real touch target,
                     and the badge hangs off the corner with a small negative
                     margin so it overlaps rather than squashing the icon. -->
                <Grid Grid.Column="2" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                    <ImageButton
                        Source="ic_bell_green.png"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        HeightRequest="24" WidthRequest="24"
                        Padding="0"
                        Aspect="AspectFit"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Clicked="OnNotificationsClicked"
                        SemanticProperties.Description="Notifications" />

                    <Border
                        x:Name="UnreadBadge"
                        IsVisible="False"
                        BackgroundColor="{StaticResource UcDanger}"
                        StrokeThickness="0"
                        Padding="5,1"
                        MinimumWidthRequest="18"
                        Margin="0,4,2,0"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        InputTransparent="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="999" />
                        </Border.StrokeShape>
                        <Label x:Name="UnreadBadgeLabel" FontSize="10" FontFamily="InterSemiBold" TextColor="White" HorizontalTextAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== The one scrolling surface ===== -->
        <RefreshView x:Name="Refresher" Grid.Row="1" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="24,28,24,20" Spacing="20">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="My Attendance" Style="{StaticResource UcH1}" FontSize="32" />
                        <Label x:Name="RecordCountLabel" Text="0 records" Style="{StaticResource UcBody}" FontSize="15" />
                    </VerticalStackLayout>

                    <!-- Primary action — leads to the check-in page (scan or manual token). -->
                    <Button
                        Text="Check In to Class"
                        Style="{StaticResource UcBtnPrimaryLarge}"
                        ImageSource="ic_scan_white.png"
                        ContentLayout="Left,10"
                        Clicked="OnCheckInClicked"
                        HorizontalOptions="Fill" />

                    <Border
                        x:Name="ErrorBox"
                        IsVisible="False"
                        BackgroundColor="{StaticResource UcPillRedBg}"
                        StrokeThickness="0"
                        Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label x:Name="ErrorLabel" Style="{StaticResource UcDangerText}" />
                    </Border>

                    <ActivityIndicator x:Name="LoadingIndicator" IsRunning="True" HorizontalOptions="Center" />

                    <!-- ===== Empty state ===== -->
                    <VerticalStackLayout x:Name="EmptyState" IsVisible="False" Spacing="10" Padding="0,30" HorizontalOptions="Center">
                        <Border
                            BackgroundColor="{StaticResource UcSurfaceAlt}"
                            StrokeThickness="0"
                            HeightRequest="56" WidthRequest="56"
                            HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Image Source="ic_scan_green.png" WidthRequest="26" HeightRequest="26" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="No attendance records yet" Style="{StaticResource UcH2}" HorizontalTextAlignment="Center" />
                        <Label
                            Text="Scan a QR code in class, or enter a token manually, to check in."
                            Style="{StaticResource UcMutedText}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- ===== History list — built in code-behind, one UcCardSoft per record ===== -->
                    <VerticalStackLayout x:Name="HistoryStack" Spacing="10" />

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- ===== Bottom navigation ===== -->
        <Border Grid.Row="2" Style="{StaticResource UcBottomBar}">
            <Grid ColumnDefinitions="*,*,*,*,*">

                <VerticalStackLayout Grid.Column="0" Spacing="3">
                    <Border Padding="14,7" HorizontalOptions="Center" BackgroundColor="Transparent" StrokeThickness="0">
                        <Image Source="ic_home_muted.png" WidthRequest="21" HeightRequest="21" Aspect="AspectFit" />
                    </Border>
                    <Label Text="Home" Style="{StaticResource UcTabLabel}" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="3">
                    <Border Padding="14,7" HorizontalOptions="Center" BackgroundColor="Transparent" StrokeThickness="0">
                        <Image Source="ic_users_muted.png" WidthRequest="21" HeightRequest="21" Aspect="AspectFit" />
                    </Border>
                    <Label Text="Groups" Style="{StaticResource UcTabLabel}" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGroupsTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="3">
                    <Border Padding="14,7" HorizontalOptions="Center" BackgroundColor="Transparent" StrokeThickness="0">
                        <Image Source="ic_briefcase_muted.png" WidthRequest="21" HeightRequest="21" Aspect="AspectFit" />
                    </Border>
                    <Label Text="Internships" Style="{StaticResource UcTabLabel}" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInternshipsTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" Spacing="3">
                    <Border Style="{StaticResource UcTabPill}">
                        <Image Source="ic_scan_green.png" WidthRequest="21" HeightRequest="21" Aspect="AspectFit" />
                    </Border>
                    <Label Text="Attendance" Style="{StaticResource UcTabLabelActive}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="4" Spacing="3">
                    <Border Padding="14,7" HorizontalOptions="Center" BackgroundColor="Transparent" StrokeThickness="0">
                        <Image Source="ic_user_circle_muted.png" WidthRequest="21" HeightRequest="21" Aspect="AspectFit" />
                    </Border>
                    <Label Text="Profile" Style="{StaticResource UcTabLabel}" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>

</ContentPage>
