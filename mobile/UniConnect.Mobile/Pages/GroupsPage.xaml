<?xml version="1.0" encoding="utf-8" ?>
<!--
    Study Groups.

    The page is one scrolling surface. Everything above the cards — title,
    search, filters, banners — lives in the CollectionView's Header rather than
    in a row above it, which is what stops the old split where the top half
    stayed put and only the list moved. The app bar and the tab bar are the only
    fixed chrome, and the FAB floats over the list between them.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UniConnect.Mobile.Services"
             xmlns:pages="clr-namespace:UniConnect.Mobile.Pages"
             x:Class="UniConnect.Mobile.Pages.GroupsPage"
             Title="Study Groups"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <models:StarLengthConverter x:Key="StarLength" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ===== Top app bar =====
             The same three elements on every screen: account avatar left, brand
             centre, notifications right. The avatar is the account menu — that
             is where sign out lives, which is why there is no separate button.

             The bell sits in a 44x44 box so it is a real touch target; the icon
             itself is centred inside it, and the badge hangs on the top-right
             corner with a small negative margin so it overlaps rather than
             squashing the icon into the remaining space. -->
        <Border Grid.Row="0" Style="{StaticResource UcAppBar}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                <Border
                    Grid.Column="0"
                    Background="{StaticResource UcAvatarBrush}"
                    Stroke="{StaticResource UcMint}"
                    StrokeThickness="2"
                    HeightRequest="38" WidthRequest="38"
                    VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19" />
                    </Border.StrokeShape>
                    <!-- The photo is layered over the monogram, so the initials
                         show until a picture exists and again if it is removed. -->
                    <Grid>
                        <Label
                            x:Name="ProfileInitials"
                            Style="{StaticResource UcAvatarText}"
                            FontSize="13" />
                        <Image
                            x:Name="ProfilePhoto"
                            IsVisible="False"
                            Aspect="AspectFill"
                            HeightRequest="38" WidthRequest="38" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <Label Grid.Column="1" Text="UniConnect" Style="{StaticResource UcAppBarTitle}" />

                <Grid Grid.Column="2" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">

                    <!-- BorderWidth 0 matters: WinUI's button chrome otherwise
                         draws a visible box around a transparent ImageButton. -->
                    <ImageButton
                        Source="ic_bell_green.png"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        HeightRequest="24" WidthRequest="24"
                        Padding="0"
                        Aspect="AspectFit"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Clicked="OnNotificationsClicked"
                        SemanticProperties.Description="Notifications" />

                    <Border
                        x:Name="UnreadBadge"
                        IsVisible="False"
                        BackgroundColor="{StaticResource UcDanger}"
                        StrokeThickness="0"
                        Padding="5,1"
                        MinimumWidthRequest="18"
                        Margin="0,4,2,0"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        InputTransparent="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="999" />
                        </Border.StrokeShape>
                        <Label
                            x:Name="UnreadBadgeLabel"
                            FontSize="10"
                            FontFamily="InterSemiBold"
                            TextColor="White"
                            HorizontalTextAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== The one scrolling surface =====
             A ScrollView rather than a CollectionView. A CollectionView measures
             its items against unbounded width regardless of the width the control
             is given, so a card's wrapping description had no edge to wrap at and
             every card overflowed the screen; its Header also draws underneath a
             centred EmptyView. Both problems disappear here, at the cost of
             virtualisation — acceptable because the list is bounded by the
             student's own enrolled courses, which is tens of groups at most. -->
        <RefreshView x:Name="Refresher" Grid.Row="1" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout x:Name="HeaderColumn" Padding="24,36,24,16" Spacing="20">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Study Groups" Style="{StaticResource UcH1}" FontSize="32" />
                            <Label
                                x:Name="SubtitleLabel"
                                Text="Find a group or create your own."
                                Style="{StaticResource UcBody}"
                                FontSize="15" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="12">
                            <Border Style="{StaticResource UcInputFrame}" Padding="16,4">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Image Grid.Column="0" Source="ic_search_muted.png" Style="{StaticResource UcIcon}" />
                                    <!-- A plain Entry rather than a SearchBar: SearchBar brings
                                         its own frame and padding, which fought this one. -->
                                    <Entry
                                        Grid.Column="1"
                                        x:Name="SearchInput"
                                        Placeholder="Search courses, topics, or groups…"
                                        ClearButtonVisibility="WhileEditing"
                                        TextChanged="OnSearchTextChanged" />
                                </Grid>
                            </Border>

                            <!-- Course selector. Narrows which groups the server returns;
                                 the chips below then narrow what is shown of them. -->
                            <Border Style="{StaticResource UcInputFrame}" Padding="16,2">
                                <!-- No Title set: on Windows a Picker renders its Title as a
                                     header AND the selection below it, so the filter read
                                     "All my courses" twice. Item 0 carries that wording. -->
                                <Picker
                                    x:Name="CoursePicker"
                                    VerticalOptions="Center"
                                    SelectedIndexChanged="OnCourseFilterChanged" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Scope filters, built in code. Horizontally scrollable so the
                             row never wraps or squeezes. -->
                        <ScrollView
                            x:Name="ChipScroller"
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout x:Name="ChipRow" Spacing="10" Padding="0,1" />
                        </ScrollView>

                        <Border
                            x:Name="UpdateBanner"
                            IsVisible="False"
                            BackgroundColor="{StaticResource UcPrimarySoft}"
                            StrokeThickness="0"
                            Padding="12,9">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                <Image Grid.Column="0" Source="ic_refresh_green.png" Style="{StaticResource UcIconSm}" />
                                <Label
                                    Grid.Column="1"
                                    Text="New study group activity is available."
                                    FontSize="13"
                                    TextColor="{StaticResource UcPrimaryDarker}"
                                    VerticalOptions="Center" />
                                <Button
                                    Grid.Column="2"
                                    Text="Refresh"
                                    Style="{StaticResource UcBtnTiny}"
                                    Clicked="OnBannerRefreshClicked" />
                            </Grid>
                        </Border>

                        <Border
                            x:Name="ErrorBox"
                            IsVisible="False"
                            BackgroundColor="{StaticResource UcPillRedBg}"
                            StrokeThickness="0"
                            Padding="14,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label
                                x:Name="ErrorLabel"
                                FontSize="13.5"
                                TextColor="{StaticResource UcPillRedFg}"
                                LineBreakMode="WordWrap" />
                        </Border>

                        <Label x:Name="ResultsLabel" Style="{StaticResource UcTiny}" Margin="2,0,0,0" />

                        <!-- The empty state lives in the header, not in
                             CollectionView.EmptyView. EmptyView is centred over the
                             whole control including the header, so it printed itself
                             across the title and the search box. Here it is simply
                             the last thing in the column. -->
                        <VerticalStackLayout
                            x:Name="EmptyState"
                            IsVisible="False"
                            Padding="10,26,10,10"
                            Spacing="10">
                            <Border
                                BackgroundColor="{StaticResource UcMint}"
                                StrokeThickness="0"
                                HeightRequest="66" WidthRequest="66"
                                HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22" />
                                </Border.StrokeShape>
                                <Image
                                    Source="ic_users_green.png"
                                    WidthRequest="30" HeightRequest="30"
                                    Aspect="AspectFit"
                                    HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <Label
                                x:Name="EmptyTitle"
                                Text="No study groups yet"
                                Style="{StaticResource UcH2}"
                                HorizontalTextAlignment="Center" />
                            <Label
                                x:Name="EmptyBody"
                                Text="There are no groups for your courses right now. Be the first to start one!"
                                Style="{StaticResource UcMutedText}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                    <!-- ===== Cards ===== -->
                    <VerticalStackLayout x:Name="CardsHost" Spacing="16">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:GroupSummary">
                                <!-- No side padding: the surrounding stack already
                                     carries the page's 24px margin. -->
                                <Grid HorizontalOptions="Fill">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCardTapped" />
                                    </Grid.GestureRecognizers>
                            <Border Style="{StaticResource UcCard}" Padding="0">
                                <Grid RowDefinitions="Auto,Auto">

                                    <!-- Accent rail: marks the groups you are in. -->
                                    <BoxView
                                        Grid.Row="0"
                                        HeightRequest="4"
                                        Color="{StaticResource UcBrandStart}"
                                        IsVisible="{Binding AmMember}" />

                                    <!-- A Grid, not a VerticalStackLayout. A stack measures its
                                         children against unbounded width, so a Label set to wrap
                                         never sees an edge to wrap at and lays out on one long
                                         line that overflows the card. Grid rows constrain it. -->
                                    <Grid
                                        Grid.Row="1"
                                        Padding="16,14,16,15"
                                        RowSpacing="9"
                                        RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Style="{StaticResource UcCodeBadge}">
                                                <Label Text="{Binding CourseCode}" Style="{StaticResource UcCodeBadgeText}" />
                                            </Border>

                                            <!-- Exactly one of these shows: joined wins over
                                                 waiting, waiting over the seat count. -->
                                            <Border Grid.Column="2" Style="{StaticResource UcPillGreen}" IsVisible="{Binding AmMember}">
                                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="5">
                                                    <Image Grid.Column="0" Source="ic_check_circle_green.png"
                                                           WidthRequest="13" HeightRequest="13" Aspect="AspectFit"
                                                           VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Text="Joined" Style="{StaticResource UcPillText}" />
                                                </Grid>
                                            </Border>

                                            <Border Grid.Column="2" Style="{StaticResource UcPillAmber}" IsVisible="{Binding AmPending}">
                                                <Label Text="Pending" Style="{StaticResource UcPillTextAmber}" />
                                            </Border>

                                            <Border Grid.Column="2" Style="{StaticResource UcPillMint}" IsVisible="{Binding ShowPopularPill}">
                                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="5">
                                                    <Image Grid.Column="0" Source="ic_sparkles_teal.png"
                                                           WidthRequest="13" HeightRequest="13" Aspect="AspectFit"
                                                           VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Text="Popular" Style="{StaticResource UcPillTextMint}" />
                                                </Grid>
                                            </Border>

                                            <Border Grid.Column="2" Style="{StaticResource UcPillGrey}" IsVisible="{Binding ShowFullPill}">
                                                <Label Text="Full" Style="{StaticResource UcPillTextGrey}" />
                                            </Border>

                                            <Border Grid.Column="2" Style="{StaticResource UcPillGrey}" IsVisible="{Binding ShowSeatPill}">
                                                <Label Text="{Binding StatusPillText}" Style="{StaticResource UcPillTextGrey}" />
                                            </Border>
                                        </Grid>

                                        <Label
                                            Grid.Row="1"
                                            Text="{Binding GroupName}"
                                            Style="{StaticResource UcH2}"
                                            FontSize="18"
                                            Margin="0,2,0,0"
                                            LineBreakMode="TailTruncation" />

                                        <!-- WordWrap, not TailTruncation: truncation keeps the
                                             text on a single line, so MaxLines never applies and
                                             a long description runs off instead of filling two. -->
                                        <Label
                                            Grid.Row="2"
                                            Text="{Binding DescriptionOrPlaceholder}"
                                            Style="{StaticResource UcMutedText}"
                                            MaxLines="2"
                                            LineBreakMode="WordWrap" />

                                        <!-- Seats -->
                                        <VerticalStackLayout Grid.Row="3" Spacing="6" Margin="0,4,0,0">
                                            <Label Text="{Binding SeatsLine}" Style="{StaticResource UcTiny}" />

                                            <Border Style="{StaticResource UcBarTrack}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding MemberProgress, Converter={StaticResource StarLength}}" />
                                                        <ColumnDefinition Width="{Binding MemberRemaining, Converter={StaticResource StarLength}}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource UcBarFill}" />
                                                </Grid>
                                            </Border>
                                        </VerticalStackLayout>

                                        <!-- Members and the way in -->
                                        <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="7" Margin="0,4,0,0">

                                            <!-- Overlapping avatar stack. The negative margin is
                                                 what makes them overlap; each carries a white ring
                                                 so the circles stay separable where they meet. -->
                                            <HorizontalStackLayout
                                                Grid.Column="0"
                                                Spacing="-9"
                                                BindableLayout.ItemsSource="{Binding AvatarInitials}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border Style="{StaticResource UcAvatarStacked}">
                                                            <Label Text="{Binding .}" Style="{StaticResource UcAvatarText}" FontSize="11" />
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </HorizontalStackLayout>

                                            <Border
                                                Grid.Column="1"
                                                Style="{StaticResource UcPillGrey}"
                                                Padding="9,6"
                                                Margin="2,0,0,0"
                                                IsVisible="{Binding HasOtherMembers}">
                                                <Label Text="{Binding OtherMembersLabel}" Style="{StaticResource UcPillTextGrey}" />
                                            </Border>

                                            <Grid Grid.Column="3" ColumnDefinitions="Auto,Auto" ColumnSpacing="5">
                                                <Label
                                                    Grid.Column="0"
                                                    Text="{Binding ViewActionText}"
                                                    FontFamily="MontserratSemiBold"
                                                    FontSize="14"
                                                    TextColor="{StaticResource UcBrandStart}"
                                                    VerticalOptions="Center" />
                                                <Image
                                                    Grid.Column="1"
                                                    Source="ic_arrow_right_green.png"
                                                    WidthRequest="15" HeightRequest="15"
                                                    Aspect="AspectFit"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Clears the FAB and the tab bar at the end of the list. -->
                    <BoxView HeightRequest="88" Color="Transparent" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- ===== Floating action ===== -->
        <ImageButton
            Grid.Row="1"
            Style="{StaticResource UcFab}"
            Source="ic_plus_white.png"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,20,20"
            Clicked="OnCreateClicked"
            SemanticProperties.Description="Create a new study group" />

        <!-- ===== Bottom navigation ===== -->
        <Border Grid.Row="2" Style="{StaticResource UcBottomBar}">
            <Grid ColumnDefinitions="*,*,*,*,*">

                <VerticalStackLayout Grid.Column="0" Spacing="3">
                    <Border Padding="14,7" HorizontalOptions="Center" BackgroundColor="Transparent" StrokeThickness="0">
                        <Image Source="ic_home_muted.png" WidthRequest="21" HeightRequest="21" Aspect="AspectFit" />
                    </Border>
                    <Label Text="Home" Style="{StaticResource UcTabLabel}" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="3">
                    <Border Style="{StaticResource UcTabPill}">
                        <Image Source="ic_users_green.png" WidthRequest="21" HeightRequest="21" Aspect="AspectFit" />
                    </Border>
                    <Label Text="Groups" Style="{StaticResource UcTabLabelActive}" />
                </VerticalStackLayout>

                <!-- Internships, not Rides: ride sharing stays web-only for now. -->
                <VerticalStackLayout Grid.Column="2" Spacing="3">
                    <Border Padding="14,7" HorizontalOptions="Center" BackgroundColor="Transparent" StrokeThickness="0">
                        <Image Source="ic_briefcase_muted.png" WidthRequest="21" HeightRequest="21" Aspect="AspectFit" />
                    </Border>
                    <Label Text="Internships" Style="{StaticResource UcTabLabel}" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInternshipsTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" Spacing="3">
                    <Border Padding="14,7" HorizontalOptions="Center" BackgroundColor="Transparent" StrokeThickness="0">
                        <Image Source="ic_scan_muted.png" WidthRequest="21" HeightRequest="21" Aspect="AspectFit" />
                    </Border>
                    <Label Text="Attendance" Style="{StaticResource UcTabLabel}" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAttendanceTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="4" Spacing="3">
                    <Border Padding="14,7" HorizontalOptions="Center" BackgroundColor="Transparent" StrokeThickness="0">
                        <Image Source="ic_user_circle_muted.png" WidthRequest="21" HeightRequest="21" Aspect="AspectFit" />
                    </Border>
                    <Label Text="Profile" Style="{StaticResource UcTabLabel}" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>

</ContentPage>
