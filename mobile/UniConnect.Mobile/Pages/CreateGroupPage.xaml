<?xml version="1.0" encoding="utf-8" ?>
<!--
    New Study Group.

    Three bands: a light app bar, the scrolling form, and an action bar pinned to
    the bottom so "Create Group" is reachable without scrolling to the end of the
    form. Each field is its own white surface on the page rather than a row inside
    one large card, which is what gives the form its open rhythm.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UniConnect.Mobile.Pages.CreateGroupPage"
             Title="New Study Group"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ===== App bar ===== -->
        <Border Grid.Row="0" Style="{StaticResource UcAppBar}" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border
                    Grid.Column="0"
                    BackgroundColor="{StaticResource UcSurfaceAlt}"
                    StrokeThickness="0"
                    HeightRequest="42" WidthRequest="42"
                    VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="21" />
                    </Border.StrokeShape>
                    <Image
                        Source="ic_arrow_left_green.png"
                        WidthRequest="20" HeightRequest="20"
                        Aspect="AspectFit"
                        HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCancelTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <Label
                    Grid.Column="1"
                    Text="New Study Group"
                    Style="{StaticResource UcH1}"
                    FontSize="23"
                    TextColor="{StaticResource UcBrandEnd}"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- ===== Form ===== -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="FormColumn" Padding="24,20,24,28" Spacing="22">

                <!-- Group name -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Group Name" Style="{StaticResource UcFieldLabel}" />
                    <Border Style="{StaticResource UcFieldBox}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Image Grid.Column="0" Source="ic_edit_muted.png" Style="{StaticResource UcIcon}" />
                            <Entry
                                Grid.Column="1"
                                x:Name="NameEntry"
                                Placeholder="e.g., Organic Chem Review"
                                MaxLength="100" />
                        </Grid>
                    </Border>
                    <Label x:Name="NameError" IsVisible="False" Style="{StaticResource UcDangerText}" />
                </VerticalStackLayout>

                <!-- Course -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Select Course" Style="{StaticResource UcFieldLabel}" />
                    <Border Style="{StaticResource UcFieldBox}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Image Grid.Column="0" Source="ic_book_green.png" Style="{StaticResource UcIcon}" />
                            <!-- No Title: on Windows it renders as a header above the
                                 selection, showing the same text twice. Item 0 is the
                                 prompt instead. -->
                            <Picker Grid.Column="1" x:Name="CoursePicker" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Label x:Name="CourseError" IsVisible="False" Style="{StaticResource UcDangerText}" />
                </VerticalStackLayout>

                <!-- Description -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Description" Style="{StaticResource UcFieldLabel}" />
                    <Border Style="{StaticResource UcFieldBox}" Padding="16,10">
                        <Editor
                            x:Name="DescriptionEditor"
                            Placeholder="What will this group focus on?"
                            MaxLength="500"
                            HeightRequest="112"
                            TextChanged="OnDescriptionChanged" />
                    </Border>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            x:Name="DescriptionError"
                            IsVisible="False"
                            Style="{StaticResource UcDangerText}" />
                        <Label Grid.Column="1" x:Name="DescriptionCount" Style="{StaticResource UcFieldHint}" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Capacity and location -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">

                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <Label Text="Capacity" Style="{StaticResource UcFieldLabel}" />
                        <Border Style="{StaticResource UcFieldBox}" Padding="10,8">
                            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="14">
                                <Border Grid.Column="0" x:Name="CapacityDown" Style="{StaticResource UcStepperBtn}">
                                    <Label Text="−" Style="{StaticResource UcStepperGlyph}" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCapacityDown" />
                                    </Border.GestureRecognizers>
                                </Border>

                                <Label
                                    Grid.Column="1"
                                    x:Name="CapacityLabel"
                                    Style="{StaticResource UcH2}"
                                    FontSize="17"
                                    WidthRequest="26"
                                    HorizontalTextAlignment="Center"
                                    VerticalOptions="Center" />

                                <Border Grid.Column="2" x:Name="CapacityUp" Style="{StaticResource UcStepperBtn}">
                                    <Label Text="+" Style="{StaticResource UcStepperGlyph}" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCapacityUp" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Text="Location" Style="{StaticResource UcFieldLabel}" />
                        <Border Style="{StaticResource UcFieldBox}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Image Grid.Column="0" Source="ic_location_muted.png" Style="{StaticResource UcIcon}" />
                                <Entry
                                    Grid.Column="1"
                                    x:Name="LocationEntry"
                                    Placeholder="e.g., Library"
                                    MaxLength="100" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Label x:Name="CapacityError" IsVisible="False" Style="{StaticResource UcDangerText}" />
                <Label x:Name="LocationError" IsVisible="False" Style="{StaticResource UcDangerText}" />

                <Border
                    x:Name="SummaryErrorBox"
                    IsVisible="False"
                    BackgroundColor="{StaticResource UcPillRedBg}"
                    StrokeThickness="0"
                    Padding="14,12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label
                        x:Name="SummaryError"
                        FontSize="13.5"
                        TextColor="{StaticResource UcPillRedFg}"
                        LineBreakMode="WordWrap" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== Action bar =====
             Pinned rather than at the end of the form, so the primary action is
             always one tap away however far down the student has scrolled. -->
        <Border Grid.Row="2" Style="{StaticResource UcActionBar}">
            <VerticalStackLayout x:Name="ActionColumn" Spacing="10">
                <ActivityIndicator
                    x:Name="Busy"
                    IsRunning="False"
                    IsVisible="False"
                    HorizontalOptions="Center" />

                <Button
                    x:Name="SubmitBtn"
                    Text="Create Group"
                    Style="{StaticResource UcBtnPrimaryLarge}"
                    ImageSource="ic_user_add_white.png"
                    ContentLayout="Left,10"
                    Clicked="OnCreateClicked"
                    HorizontalOptions="Fill" />
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
